{
  "name": "anatoscan-ar",
  "version": "1.0.0",
  "private": true,
  "description": "AnatoScan AR – QR-based Anatomy Learning & Management Platform",
  "scripts": {
    "dev": "pnpm --parallel --filter @anatoscan/* --filter api --filter web dev",
    "build": "pnpm --filter @anatoscan/shared build && pnpm --filter api build && pnpm --filter web build",
    "lint": "pnpm --filter './apps/*' lint",
    "test": "pnpm --filter './apps/*' test",
    "db:generate": "pnpm --filter api run prisma:generate",
    "db:migrate": "pnpm --filter api run prisma:migrate",
    "db:seed": "pnpm --filter api run prisma:seed",
    "db:studio": "pnpm --filter api run prisma:studio",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f docker/docker-compose.yml down"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "devDependencies": {
    "typescript": "^5.5.4"
  }
}
