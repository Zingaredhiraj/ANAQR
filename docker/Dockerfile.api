# Multi-stage Dockerfile for AnatoScan AR NestJS API (Backend)
FROM node:20-alpine AS base
RUN corepack enable && corepack prepare pnpm@9.15.9 --activate
WORKDIR /app

# Stage 1: Dependencies
FROM base AS dependencies
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY backend/package.json ./backend/
COPY packages/shared/package.json ./packages/shared/
RUN pnpm install --frozen-lockfile

# Stage 2: Build
FROM dependencies AS builder
COPY packages/shared ./packages/shared
COPY backend ./backend
RUN pnpm --filter @anatoscan/shared build
RUN cd backend && pnpm prisma generate
RUN pnpm --filter backend build
RUN cd backend && npx tsc prisma/seed.ts --outDir dist/prisma --skipLibCheck --module commonjs --target es2021 --esModuleInterop
RUN pnpm --filter backend deploy --prod /prod/backend
RUN cp -r /app/node_modules/.pnpm/@prisma+client* /prod/backend/node_modules/.pnpm/

# Stage 3: Production Runner
FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
RUN addgroup --system --gid 1001 nodejs && adduser --system --uid 1001 nestjs

COPY --from=builder /prod/backend/node_modules ./node_modules
COPY --from=builder /app/backend/dist ./dist
COPY --from=builder /app/backend/prisma ./prisma
COPY --from=builder /app/backend/package.json ./package.json

USER nestjs
ENV PORT=10000
EXPOSE 10000
CMD ["sh", "-c", "npx prisma migrate deploy && node dist/prisma/seed.js; node dist/main.js"]
