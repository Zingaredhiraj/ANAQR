# ============================================================
# AnatoScan AR – Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to source control.
# ============================================================

# --- PostgreSQL ---
DATABASE_URL="postgresql://anatoscan:anatoscan_dev@localhost:5432/anatoscan_db?schema=public"

# --- Redis ---
REDIS_URL="redis://localhost:6379"

# --- NestJS API ---
API_PORT=4000
API_BASE_URL=http://localhost:4000

# --- Next.js ---
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- JWT ---
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_MIN_64_CHARS
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=CHANGE_THIS_TO_ANOTHER_LONG_RANDOM_SECRET
JWT_REFRESH_EXPIRES_IN=30d

# --- Argon2 ---
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1

# --- Object Storage (Cloudflare R2 or AWS S3-compatible) ---
S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=anatoscan-assets
S3_ACCESS_KEY_ID=your_r2_access_key
S3_SECRET_ACCESS_KEY=your_r2_secret_key
S3_PUBLIC_URL=https://assets.yourdomain.com

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,https://anatoscan.yourdomain.com

# --- Rate Limiting ---
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# --- Cookie ---
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# --- Super Admin Bootstrap ---
SUPER_ADMIN_EMAIL=admin@anatoscan.edu
SUPER_ADMIN_PASSWORD=ChangeThisStrongPassword123!

# --- AI (Optional – leave empty to disable) ---
GEMINI_API_KEY=
